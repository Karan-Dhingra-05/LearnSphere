# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Environment variables (never commit secrets) ─────────────────────────────
.env
.env.local
.env.production
.env.development
.env.*.local

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/

# ─── Uploaded PDFs (user-generated content — not source code) ─────────────────
server/uploads/*.pdf

# ─── FAISS vector index (auto-generated from uploaded documents) ───────────────
server/faiss/index.bin
server/faiss/metadata.json

# ─── Hugging Face model cache (downloaded at runtime) ─────────────────────────
.cache/

# ─── Editor & OS ──────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

